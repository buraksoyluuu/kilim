# iOS: Unity'nin Xcode projesini kalıcı dağıtım sertifikası (APPLE_DIST_CERT) + API anahtarıyla alınan App Store
# profiliyle imzalayıp TestFlight'a yükler. Android: AAB'yi Google Play internal teste yükler.
require "base64"
require "openssl"
require "fileutils"
require "json"
default_platform(:ios)

platform :ios do
  lane :beta do
    key_path = File.expand_path("AuthKey.p8")
    # Secret yapıştırılırken satır sonları kaybolabiliyor: gövdeyi ayıklayıp PEM'i yeniden kur.
    raw = ENV.fetch("APPSTORE_P8").strip
    raw = Base64.decode64(raw) unless raw.include?("PRIVATE KEY")
    body = raw.gsub(/-----(BEGIN|END) PRIVATE KEY-----/, "").gsub(/\s+/, "")
    UI.user_error!("APPSTORE_P8 boş ya da hatalı (gövde #{body.length} karakter)") if body.length < 100
    pem = "-----BEGIN PRIVATE KEY-----\n#{body.scan(/.{1,64}/).join("\n")}\n-----END PRIVATE KEY-----\n"
    File.write(key_path, pem)
    begin
      OpenSSL::PKey.read(pem)
    rescue => e
      UI.user_error!("APPSTORE_P8 okunamadı (#{e.message}); gövde #{body.length} karakter, AuthKey_*.p8 dosyasının tamamını yapıştır")
    end
    api_key = app_store_connect_api_key(key_id: ENV.fetch("APPSTORE_KEY_ID"), issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"), key_filepath: key_path)
    setup_ci
    project = Dir[File.expand_path("../build/iOS/**/Unity-iPhone.xcodeproj", __dir__)].first
    UI.user_error!("Xcode projesi bulunamadı") unless project
    build = latest_testflight_build_number(api_key: api_key, app_identifier: "app.kilim.game", initial_build_number: 0) + 1
    increment_build_number(xcodeproj: project, build_number: build)
    auth = "-allowProvisioningUpdates -authenticationKeyPath #{key_path} -authenticationKeyID #{ENV['APPSTORE_KEY_ID']} -authenticationKeyIssuerID #{ENV['APPSTORE_ISSUER_ID']}"
    # Ekipte kayıtlı cihaz yok: otomatik imzalama geliştirme profili üretemiyor.
    # Dağıtım sertifikası + App Store profili API anahtarıyla alınır, uygulama hedefi elle imzalanır.
    team = ENV.fetch("APPLE_TEAM_ID")
    keychain = File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db")
    # Apple ara sertifikası (WWDR G3) olmadan yeni sertifika "kurulu değil" görünüyor.
    sh("curl -sSLo /tmp/AppleWWDRCAG3.cer https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer && security import /tmp/AppleWWDRCAG3.cer -k #{keychain} -T /usr/bin/codesign || true")
    stored = ENV["APPLE_DIST_CERT"].to_s.strip
    prev = File.expand_path("../dist-cert-in/APPLE_DIST_CERT.txt", __dir__)
    stored = File.read(prev).strip if stored.empty? && File.exist?(prev)
    if stored.empty?
      # İlk kurulum: sertifikayı bir kez üret; sertifika + anahtar base64 metin olarak artifact'a yazılır,
      # o metin APPLE_DIST_CERT secret'ına yapıştırılınca sonraki çalıştırmalar aynı sertifikayı kullanır.
      get_certificates(api_key: api_key, development: false, generate_apple_certs: true,
                       keychain_path: keychain, keychain_password: "", output_path: "/tmp/cert")
      cer = Dir["/tmp/cert/*.cer"].first
      key = Dir["/tmp/cert/*.p12"].first || Dir["/tmp/cert/*.pem"].first
      UI.user_error!("Sertifika dosyaları bulunamadı: #{Dir['/tmp/cert/*'].join(', ')}") unless cer && key
      blob = { "cer" => Base64.strict_encode64(File.binread(cer)), "key" => Base64.strict_encode64(File.binread(key)) }
      out = File.expand_path("../dist-cert/APPLE_DIST_CERT.txt", __dir__)
      FileUtils.mkdir_p(File.dirname(out))
      File.write(out, Base64.strict_encode64(JSON.generate(blob)))
      UI.important("Dağıtım sertifikası üretildi → dist-cert artifact'ındaki metni APPLE_DIST_CERT secret'ına ekleyin")
    else
      blob = JSON.parse(Base64.decode64(stored))
      File.binwrite("/tmp/dist.cer", Base64.decode64(blob["cer"]))
      File.binwrite("/tmp/dist.key", Base64.decode64(blob["key"]))
      sh("security import /tmp/dist.key -k #{keychain} -T /usr/bin/codesign -T /usr/bin/security")
      sh("security import /tmp/dist.cer -k #{keychain} -T /usr/bin/codesign -T /usr/bin/security")
      sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k '' #{keychain}")
    end
    get_provisioning_profile(api_key: api_key, app_identifier: "app.kilim.game",
                             force: true, filename: "kilim_appstore.mobileprovision")
    profile_name = lane_context[SharedValues::SIGH_NAME]
    update_code_signing_settings(path: project, use_automatic_signing: false, team_id: team, targets: ["Unity-iPhone"],
                                 code_sign_identity: "Apple Distribution", profile_name: profile_name)
    update_code_signing_settings(path: project, use_automatic_signing: false, team_id: team, targets: ["UnityFramework"],
                                 code_sign_identity: "Apple Distribution")
    # Google Mobile Ads CocoaPods ile gelir (EDM4U Podfile üretir): pod install → .xcworkspace.
    # Kaynak paket hedefleri imza istemesin (manuel imzada "requires a development team" hatası).
    dir = File.dirname(project)
    podfile = File.join(dir, "Podfile")
    workspace = nil
    if File.exist?(podfile)
      File.write(podfile, File.read(podfile) + <<~POD) unless File.read(podfile).include?("CODE_SIGNING_ALLOWED")
        post_install do |installer|
          installer.pods_project.targets.each do |t|
            t.build_configurations.each { |c| c.build_settings["CODE_SIGNING_ALLOWED"] = "NO" }
          end
        end
      POD
      sh("cd '#{dir}' && pod install --repo-update")
      workspace = Dir[File.join(dir, "*.xcworkspace")].first
    end
    build_app(workspace: workspace, project: (workspace ? nil : project), scheme: "Unity-iPhone", configuration: "Release", export_method: "app-store",
              export_options: { signingStyle: "manual", teamID: team,
                                provisioningProfiles: { "app.kilim.game" => profile_name } })
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end

platform :android do
  desc "AAB → Google Play internal test (GOOGLE_PLAY_JSON: servis hesabı JSON anahtarı)"
  lane :internal do
    aab = Dir[File.expand_path("../build/Android/*.aab", __dir__)].first
    UI.user_error!("AAB bulunamadı") unless aab
    upload_to_play_store(package_name: "app.kilim.game", track: "internal", aab: aab,
                         json_key_data: ENV.fetch("GOOGLE_PLAY_JSON"), release_status: "completed",
                         skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true)
  end
end
