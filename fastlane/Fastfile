# iOS: Unity'nin ürettiği Xcode projesini imzalayıp TestFlight'a yükler.
default_platform(:ios)

platform :ios do
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_content: ENV["APPSTORE_P8"]
    )
    setup_ci
    match(type: "appstore", readonly: true, git_url: ENV["MATCH_GIT_URL"], app_identifier: ENV["IOS_BUNDLE_ID"], api_key: api_key)
    project = Dir["build/iOS/**/Unity-iPhone.xcodeproj"].first
    update_code_signing_settings(path: project, use_automatic_signing: false, team_id: ENV["sigh_#{ENV['IOS_BUNDLE_ID']}_appstore_team-id"],
                                 profile_name: ENV["sigh_#{ENV['IOS_BUNDLE_ID']}_appstore_profile-name"], code_sign_identity: "iPhone Distribution")
    increment_build_number(xcodeproj: project, build_number: latest_testflight_build_number(api_key: api_key) + 1)
    build_app(project: project, scheme: "Unity-iPhone", export_method: "app-store")
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
