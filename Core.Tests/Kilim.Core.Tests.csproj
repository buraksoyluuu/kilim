<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bağımlılıksız test koşucusu: dotnet run (proje: Core.Tests). Çıkış kodu 0 = tümü geçti. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core kaynakları doğrudan derlenir: Unity'nin derlediği dosyaların aynısı. -->
    <Compile Include="../Core/Runtime/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../Data/levels/*.json" Link="levels/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
